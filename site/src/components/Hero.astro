---
import { SITE_CONFIG } from "../config";
---

<section class="relative pt-12 pb-20 md:pt-20 md:pb-28 overflow-hidden">
  <div class="max-w-5xl mx-auto px-6 text-center">
    <!-- Philia Wisdom Pill Badge -->
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-[#D5CCC0] bg-[#F4EFEA] text-[12px] font-mono font-medium text-[#7A7268] mb-8 shadow-xs">
      <span class="w-2 h-2 rounded-full bg-[#C26910] animate-pulse"></span>
      <span class="text-[#26221E] font-serif italic text-sm">philia (φιλία)</span>
      <span class="text-[#B8ADA0]">•</span>
      <span class="tracking-wide uppercase text-[11px]">Contract-Driven Autonomous Agent</span>
    </div>

    <!-- Main Editorial Headline -->
    <h1 class="font-serif text-4xl sm:text-5xl md:text-6xl lg:text-[68px] font-normal tracking-tight text-[#26221E] leading-[1.12] mb-6 max-w-4xl mx-auto">
      The token-efficient coding agent built like a <span class="italic font-serif text-[#C26910]">careful teammate</span>.
    </h1>

    <!-- Subtitle -->
    <p class="text-lg md:text-xl text-[#6B635B] max-w-2xl mx-auto font-normal leading-relaxed mb-10">
      Built with <span class="text-[#26221E] font-medium">LangGraph</span>, <span class="text-[#26221E] font-medium">DeepAgents</span>, and code-enforced guardrails. Phil plans with you, implements in isolated git worktrees, and never burns your API budget in an unguided loop.
    </p>

    <!-- Call to Actions -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-16">
      <a
        href={SITE_CONFIG.links.github}
        target="_blank"
        rel="noopener noreferrer"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-6 py-3.5 rounded-full bg-[#26221E] text-[#FAF8F5] text-sm font-medium hover:bg-[#3D3732] shadow-md hover:shadow-lg transition-all"
      >
        <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
        </svg>
        <span>Explore on GitHub</span>
        <span class="text-[#D5CCC0]">→</span>
      </a>

      <a
        href="#origin"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-full border border-[#D5CCC0] bg-[#F4EFEA] text-[#26221E] text-sm font-medium hover:bg-[#EFE9E2] hover:border-[#B8ADA0] transition-all"
      >
        <span>The Engineering Story</span>
        <span class="text-[#7A7268]">↓</span>
      </a>

      <a
        href={SITE_CONFIG.links.devlog}
        target="_blank"
        rel="noopener noreferrer"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-1.5 px-5 py-3.5 text-sm font-mono text-[#7A7268] hover:text-[#26221E] transition-colors"
      >
        <span>Dev Log Series</span>
        <span class="text-xs">↗</span>
      </a>
    </div>

    <!-- Quick Terminal Install Snippet -->
    <div class="inline-flex items-center gap-3 px-4 py-2.5 rounded-xl border border-[#E5DDD3] bg-[#F4EFEA]/80 font-mono text-xs text-[#26221E] shadow-2xs mb-16">
      <span class="text-[#C26910]">$</span>
      <span class="select-all">uv tool install --editable git+https://github.com/ahochoy/phil.git</span>
      <span class="text-[11px] text-[#A3998C] hidden sm:inline">(editable CLI)</span>
    </div>

    <!-- Metrics Bar with Gemstone Accents -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 max-w-4xl mx-auto pt-6 border-t border-[#E5DDD3]">
      {SITE_CONFIG.metrics.map((item, idx) => (
        <div class="flex flex-col items-center p-3 text-center">
          <div class="flex items-center gap-1.5">
            <span class={`w-1.5 h-1.5 rounded-full ${
              idx === 0 ? "bg-[#C26910]" :
              idx === 1 ? "bg-[#0B7A5A]" :
              idx === 2 ? "bg-[#6D28D9]" : "bg-[#B45309]"
            }`}></span>
            <span class="font-serif text-2xl md:text-3xl font-medium text-[#26221E]">
              {item.value}
            </span>
          </div>
          <span class="text-xs font-semibold text-[#26221E] mt-1 font-sans">{item.label}</span>
          <span class="text-[11px] text-[#7A7268] mt-0.5 max-w-[160px] leading-tight font-sans">
            {item.sublabel}
          </span>
        </div>
      ))}
    </div>
  </div>
</section>
