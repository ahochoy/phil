---
import { SITE_CONFIG } from "../config";
import Spiral from "./Spiral.astro";

const installCommand = "uv tool install phil-agent";
---

<section class="hero">
  <div class="max-w-6xl mx-auto px-6 pt-14 pb-20 md:pt-20 md:pb-28 grid grid-cols-1 md:grid-cols-[1fr_1.05fr] gap-12 md:gap-14 items-center">
    <div>
      <p class="label text-phi-muted flex items-center gap-2.5 mb-5">
        <span class="w-[7px] h-[7px] rounded-full bg-phi-yellow"></span>
        <span>{SITE_CONFIG.subtitle}</span>
      </p>

      <h1 class="font-serif font-light text-[88px] sm:text-[104px] lg:text-[120px] leading-[0.9] tracking-[-0.035em] text-phi-head mb-6">
        Phil
      </h1>

      <p class="text-lg leading-relaxed text-phi-text max-w-[30em] mb-7">
        Phil is a terminal coding agent built on LangGraph. <span class="text-phi-muted">It sends each request down the fixed workflow that fits it, and uses the cheaper model wherever that's enough. It's open source.</span>
      </p>

      <div class="flex flex-wrap gap-3 mb-6">
        <a href="#run" class="label inline-flex items-center gap-2 h-9 px-[18px] rounded-full bg-phi-pill text-phi-ink hover:bg-phi-head transition-colors">
          <span>See a run</span><span aria-hidden="true">↓</span>
        </a>
        <a
          href={SITE_CONFIG.links.github}
          target="_blank"
          rel="noopener noreferrer"
          class="label inline-flex items-center h-9 px-[18px] rounded-full border border-[#3b3a37] text-phi-text hover:text-phi-head hover:border-phi-muted transition-colors"
        >GitHub</a>
      </div>

      <div class="inline-flex max-w-full items-center gap-3 pl-3.5 pr-1.5 py-1.5 rounded-lg border border-phi-rule font-mono text-[13px] text-phi-text">
        <span class="text-phi-yellow" aria-hidden="true">›</span>
        <code class="select-all truncate min-w-0">{installCommand}</code>
        <button
          type="button"
          hidden
          data-copy={installCommand}
          class="label shrink-0 px-2.5 py-1 rounded-md border border-phi-rule text-phi-muted hover:text-phi-head transition-colors"
        >Copy</button>
      </div>
    </div>

    <div class="w-full max-w-[46rem] justify-self-center">
      <Spiral />
    </div>
  </div>
</section>

<script>
  import { setupCopyButtons } from "../scripts/copy-command";

  const section = document.querySelector<HTMLElement>(".hero");
  if (section) setupCopyButtons(section);
</script>
