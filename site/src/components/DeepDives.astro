---
// Five design decisions. A figure appears only where docs/guide.md or docs/journey/ measured it.
// Each card opens with a line figure (src/figures.ts) of its main point; the text says it all, so
// the figures are hidden from screen readers.
import { FIGURES, pointsAttr, viewBox } from "../figures";

const STROKE = "#6a665f";
const FAINT = "#3d3b38";
const ACCENT = { blue: "var(--color-phi-sky)", yellow: "var(--color-phi-yellow)", red: "var(--color-phi-red)" };

interface Decision {
  label: string;
  title: string;
  chose: string;
  why: string;
  saw?: string;
}

const DECISIONS: Decision[] = [
  {
    label: "Routing",
    title: "A classifier picks the workflow",
    chose:
      "A small decision model, TypeSafe Jev, sorts each request into a path. If Jev is unavailable, your low model does it.",
    why: "Deciding whether you asked a question or want a refactor is a classification problem. It doesn't need a large chat model.",
    saw: "In the 2026-10-06 benchmark, Jev routed 50 cases with no wrong-path or unsafe routes, about 12× faster than the low model at p95 and about 4× cheaper.",
  },
  {
    label: "Models",
    title: "Two tiers, plus vision",
    chose:
      "A high tier for judgement (architect, critic, reviewer) and a low tier for doing the work (implementer, tester). An optional vision model reads images only when an agent's own model can't. Each tier can come from OpenRouter, OpenAI, Anthropic, Google, Ollama, or an OpenAI-compatible endpoint.",
    why: "Most of a run is routine work. Paying for the most capable model on every step spends the most where it helps the least.",
  },
  {
    label: "Structure",
    title: "A fixed graph, not a free-roaming agent",
    chose:
      "Each workflow is a LangGraph graph. Its steps hand the next one a contract it can check, and state is checkpointed in SQLite.",
    why: "A run that always takes the same steps is easier to predict, to measure and to debug, and a stopped run resumes where it left off.",
  },
  {
    label: "Context",
    title: "Context kept small",
    chose:
      "Sub-agents return short answers instead of their whole search. Repeated history is prompt-cached on Anthropic models; other vendors cache on their own. Skills load only for the stages they help.",
    why: "Most tokens in a long run are the same context sent again. Sending less, and paying less for what repeats, is where the savings are.",
    saw: "With prompt caching on, 68% of the architect's input came from the cache, and its cost on the same goal fell from $0.38 to $0.21.",
  },
  {
    label: "Security",
    title: "Agent shells never see your keys",
    chose:
      "Key and token variables are removed from every command an agent runs, code those commands run can't read a stored key through keyring, and commands with shell operators are rejected.",
    why: "An agent that can run shell commands is one prompt injection away from reading your keys. This doesn't stop a malicious test from reaching the OS keychain directly, so review what agents add.",
  },
];
---

<section id="decisions" class="border-t border-phi-rule py-20 md:py-24">
  <div class="max-w-6xl mx-auto px-6">
    <div class="max-w-2xl mb-12">
      <p class="label text-phi-muted flex items-center gap-2.5 mb-5">
        <span class="w-[7px] h-[7px] rounded-full bg-phi-yellow"></span>
        <span>Decisions</span>
      </p>
      <h2 class="font-serif font-light text-4xl sm:text-5xl lg:text-[52px] leading-[1.05] tracking-[-0.025em] text-phi-head mb-4">
        Five decisions.
      </h2>
      <p class="text-lg leading-relaxed text-phi-text">
        The choices that shape the experiment, and what we saw.
      </p>
    </div>

    <!-- Cells divided by hairlines; the odd fifth card spans both columns, figure beside the text. -->
    <div class="grid grid-cols-1 md:grid-cols-2 border-t border-l border-phi-rule">
      {DECISIONS.map((d, i) => {
        const shapes = FIGURES[i];
        const last = i === DECISIONS.length - 1;
        return (
          <div
            data-decision
            class:list={[
              "p-7 md:p-8 border-r border-b border-phi-rule",
              last && "md:col-span-2 md:grid md:grid-cols-2 md:gap-10 md:items-center",
            ]}
          >
            <figure class="mb-7 md:mb-8" class:list={[last && "md:mb-0"]}>
              <p class="label text-[#5a5650]">FIG 0.{i + 1}</p>
              <div class="h-44 flex items-center justify-center mt-3">
                <svg data-figure viewBox={viewBox(shapes)} class="h-full max-w-full" aria-hidden="true" fill="none" stroke-width="0.055" stroke-linejoin="round" stroke-linecap="round">
                  {shapes.map((s) => {
                    const stroke = s.faint ? FAINT : STROKE;
                    const dash = s.dotted ? "0.06 0.16" : undefined;
                    if (s.kind === "circle")
                      return s.accent ? (
                        <circle cx={s.points[0][0]} cy={s.points[0][1]} r={s.r} fill={ACCENT[s.accent]} stroke="none" />
                      ) : (
                        <circle cx={s.points[0][0]} cy={s.points[0][1]} r={s.r} stroke={stroke} stroke-dasharray={dash} />
                      );
                    if (s.kind === "line")
                      return <polyline points={pointsAttr(s.points)} stroke={stroke} stroke-dasharray={dash} />;
                    return (
                      <polygon
                        points={pointsAttr(s.points)}
                        stroke={stroke}
                        stroke-dasharray={dash}
                        fill={s.fill ? "var(--color-phi-ink)" : "none"}
                      />
                    );
                  })}
                </svg>
              </div>
            </figure>
            <div>
              <p class="label text-phi-muted">{String(i + 1).padStart(2, "0")} · {d.label}</p>
              <h3 class="font-serif font-light text-[26px] leading-tight text-phi-head mt-3 mb-3">{d.title}</h3>
              <p class="text-sm leading-relaxed text-phi-text mb-3">{d.chose}</p>
              <p class="text-sm leading-relaxed text-phi-muted">{d.why}</p>
              {d.saw && (
                <p class="mt-5 pt-4 border-t border-dashed border-phi-rule text-[13px] leading-relaxed text-phi-muted">
                  <span class="text-phi-text font-normal">What we saw:</span> {d.saw}
                </p>
              )}
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>
