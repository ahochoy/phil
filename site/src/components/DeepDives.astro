---
// Five design decisions. A figure appears only where docs/guide.md or docs/journey/ measured it.
interface Decision {
  label: string;
  title: string;
  chose: string;
  why: string;
  saw?: string;
  dot: string;
}

const DECISIONS: Decision[] = [
  {
    label: "Routing",
    title: "A classifier picks the workflow",
    chose:
      "A small decision model, TypeSafe Jev, sorts each request into a path. If Jev is unavailable, your low model does it.",
    why: "Deciding whether you asked a question or want a refactor is a classification problem. It doesn't need a large chat model.",
    saw: "In the 2026-10-06 benchmark, Jev routed 50 cases with no wrong-path or unsafe routes, about 12× faster than the low model at p95 and about 4× cheaper.",
    dot: "bg-[#C26910]",
  },
  {
    label: "Models",
    title: "Two tiers, plus vision",
    chose:
      "A high tier for judgement (architect, critic, reviewer) and a low tier for doing the work (implementer, tester). An optional vision model reads images only when an agent's own model can't. Each tier can come from OpenRouter, OpenAI, Anthropic, Google, Ollama, or an OpenAI-compatible endpoint.",
    why: "Most of a run is routine work. Paying for the most capable model on every step spends the most where it helps the least.",
    dot: "bg-[#0B7A5A]",
  },
  {
    label: "Structure",
    title: "A fixed graph, not a free-roaming agent",
    chose:
      "Each workflow is a LangGraph graph. Its steps hand the next one a contract it can check, and state is checkpointed in SQLite.",
    why: "A run that always takes the same steps is easier to predict, to measure and to debug, and a stopped run resumes where it left off.",
    dot: "bg-[#6D28D9]",
  },
  {
    label: "Context",
    title: "Context kept small",
    chose:
      "Sub-agents return short answers instead of their whole search. Repeated history is prompt-cached. Skills load only for the stages they help.",
    why: "Most tokens in a long run are the same context sent again. Sending less, and paying less for what repeats, is where the savings are.",
    saw: "With prompt caching on, 68% of the architect's input came from the cache, and its cost on the same goal fell from $0.38 to $0.21.",
    dot: "bg-[#B45309]",
  },
  {
    label: "Security",
    title: "Agent shells never see your keys",
    chose:
      "API keys and tokens are removed from every command an agent runs, those commands can't read the OS key store, and commands with shell operators are rejected.",
    why: "An agent that can run shell commands is one prompt injection away from reading your keys. Phil assumes that will happen.",
    dot: "bg-[#1E40AF]",
  },
];
---

<section id="decisions" class="py-20 md:py-28 border-t border-[#E5DDD3] bg-[#FAF8F5]">
  <div class="max-w-5xl mx-auto px-6">
    <div class="flex items-center gap-2 mb-4 font-mono text-xs uppercase tracking-wider text-[#7A7268]">
      <span class="w-2 h-2 rounded-full bg-[#6D28D9]"></span>
      <span>Decisions</span>
    </div>

    <div class="max-w-2xl mb-14">
      <h2 class="font-serif text-3xl sm:text-4xl lg:text-[44px] font-normal text-[#26221E] leading-[1.2] mb-4">
        Five decisions.
      </h2>
      <p class="text-base sm:text-lg text-[#6B635B] leading-relaxed">
        The choices that shape the experiment, and what we saw.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {DECISIONS.map((d, i) => (
        <div data-decision class="p-7 rounded-3xl bg-[#F4EFEA] border border-[#E5DDD3]">
          <div class="flex items-center gap-2 mb-4 font-mono text-xs uppercase text-[#7A7268]">
            <span class={`w-2 h-2 rounded-full ${d.dot}`}></span>
            <span>{String(i + 1).padStart(2, "0")} · {d.label}</span>
          </div>
          <h3 class="font-serif text-2xl font-medium text-[#26221E] mb-3">{d.title}</h3>
          <p class="text-sm text-[#4A443D] leading-relaxed mb-3">{d.chose}</p>
          <p class="text-sm text-[#6B635B] leading-relaxed mb-5">{d.why}</p>
          {d.saw && (
            <div class="p-3 rounded-xl bg-[#FAF8F5] border border-[#E5DDD3] text-[11px] font-mono text-[#7A7268] leading-relaxed">
              <span class="text-[#26221E]">What we saw:</span> {d.saw}
            </div>
          )}
        </div>
      ))}
    </div>
  </div>
</section>
