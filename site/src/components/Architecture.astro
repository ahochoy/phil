---
// The three paths a request can take (docs/guide.md, "Routing"), drawn in LangGraph's visual
// language: dashed boxes for the steps, arrows between them, labelled arrows for the loops.
// Each path keeps one colour across the site: answer blue, quick yellow, full red.
type Loop = { from: number; to: number; label: string }; // from a lower box back up to the one above
type Flow = {
  path: "answer" | "quick" | "full";
  name: string;
  dot: string;
  text: string;
  stroke: string;
  heading: string;
  steps: string[];
  loops: Loop[];
  out: string;
  caption: string;
  title: string;
};

const flows: Flow[] = [
  {
    path: "answer",
    name: "Answer",
    dot: "bg-phi-blue",
    text: "text-phi-sky",
    stroke: "var(--color-phi-sky)",
    heading: "A question or a diagnosis.",
    steps: ["read-only agent"],
    loops: [],
    out: "reply",
    caption: "It reads a snapshot of your working tree. No branch, no commits.",
    title: "Answer path: a read-only agent replies.",
  },
  {
    path: "quick",
    name: "Quick",
    dot: "bg-phi-yellow",
    text: "text-phi-yellow",
    stroke: "var(--color-phi-yellow)",
    heading: "A small, well-specified change.",
    steps: ["intake", "implement", "review"],
    loops: [{ from: 2, to: 1, label: "one fix" }],
    out: "branch",
    caption: "One task, one review, at most one fix. If it still fails, Phil offers the full path.",
    title: "Quick path: intake, implement, review; review can send one fix back to implement; ends in a branch.",
  },
  {
    path: "full",
    name: "Full",
    dot: "bg-phi-red",
    text: "text-phi-red",
    stroke: "var(--color-phi-red)",
    heading: "A feature, a refactor, design work or a broad project.",
    steps: ["intake", "architect", "critic", "you approve", "tasks in a worktree", "reviewer"],
    loops: [
      { from: 2, to: 1, label: "revise" },
      { from: 5, to: 4, label: "fix tasks" },
    ],
    out: "branch ready for a PR",
    caption: "Planned, critiqued and approved before any code is written. Design options on request.",
    title:
      "Full path: intake, architect, critic (which can send the plan back to the architect to revise), your approval, tasks in a worktree, reviewer (which can send fix tasks back); ends in a branch ready for a PR.",
  },
];

// Geometry of one column, in SVG units.
const W = 300;
const BOX_W = 200;
const BOX_H = 40;
const GAP = 36; // the arrow between two boxes
const LEAD = 30; // the arrow into the first box, and out of the last
const X = (W - BOX_W) / 2;
const CX = W / 2;
const top = (i: number) => LEAD + i * (BOX_H + GAP);
const height = (n: number) => top(n - 1) + BOX_H + LEAD + 22;
// A loop leaves the right edge of the lower box and curves back into the right edge of the box above.
const loopPath = (l: Loop) => {
  const y1 = top(l.from) + BOX_H / 2;
  const y2 = top(l.to) + BOX_H / 2;
  const x = X + BOX_W;
  return `M ${x} ${y1} C ${x + 44} ${y1}, ${x + 44} ${y2}, ${x + 6} ${y2}`;
};

const stack = [
  "Python 3.14",
  "LangGraph",
  "LangChain",
  "DeepAgents",
  "Textual",
  "Rich",
  "Typer",
  "prompt_toolkit",
  "SQLite checkpoints",
];
---

<section id="how-it-works" class="border-t border-phi-rule py-20 md:py-24">
  <div class="max-w-6xl mx-auto px-6">
    <div class="max-w-2xl mb-12">
      <p class="label text-phi-muted flex items-center gap-2.5 mb-5">
        <span class="w-[7px] h-[7px] rounded-full bg-phi-blue"></span>
        <span>How it works</span>
      </p>
      <h2 class="font-serif font-light text-4xl sm:text-5xl lg:text-[52px] leading-[1.05] tracking-[-0.025em] text-phi-head mb-4">
        A request, a classifier, three paths.
      </h2>
      <p class="text-lg leading-relaxed text-phi-text">
        A classifier reads each request and picks one of three fixed workflows. Each workflow is a LangGraph graph, so a run always takes the same steps for the same kind of request, and a small change never pays for a big one's process.
      </p>
    </div>

    <!-- Shared start: request, then classifier -->
    <div class="flex flex-col items-center gap-3 label">
      <span class="px-4 py-2.5 rounded-md border border-dashed border-[#4a4844] text-phi-text">Your request</span>
      <span data-arrow-down class="text-phi-muted" aria-hidden="true">↓</span>
      <span class="px-4 py-2.5 rounded-md bg-phi-head text-phi-ink text-center">
        Classifier
        <span class="block normal-case tracking-normal text-[11px] text-[#5a5650] mt-0.5">Jev, or your low model if Jev is unavailable</span>
      </span>
      <span data-arrow-down class="text-phi-muted md:hidden" aria-hidden="true">↓</span>
    </div>

    <!-- The fork into three columns (wide screens; the columns stack on phones) -->
    <svg data-fork class="hidden md:block w-full h-12 text-phi-muted" viewBox="0 0 600 48" preserveAspectRatio="none" aria-hidden="true">
      <g fill="none" stroke="currentColor" stroke-width="1.25" vector-effect="non-scaling-stroke">
        <path d="M 300 0 L 300 12 M 100 12 L 500 12 M 100 12 L 100 48 M 300 12 L 300 48 M 500 12 L 500 48" vector-effect="non-scaling-stroke" />
      </g>
    </svg>

    <div class="grid grid-cols-1 md:grid-cols-3 mb-10">
      {flows.map((f, col) => (
        <div
          data-path={f.path}
          class:list={[
            "px-4 py-8 md:py-2 flex flex-col items-center text-center",
            col > 0 && "border-t md:border-t-0 md:border-l border-dashed border-phi-rule",
          ]}
        >
          <p class={`label ${f.text} flex items-center gap-2`}><span class={`w-[7px] h-[7px] rounded-full ${f.dot}`}></span>{f.name}</p>
          <h3 class="font-serif font-normal text-[20px] leading-snug text-phi-head mt-3 mb-1 max-w-[18rem] md:min-h-[3.5rem]">{f.heading}</h3>
          <svg
            class="w-full max-w-[300px] h-auto"
            viewBox={`0 0 ${W} ${height(f.steps.length)}`}
            role="img"
            aria-labelledby={`flow-${f.path}-title`}
          >
            <title id={`flow-${f.path}-title`}>{f.title}</title>
            <defs>
              <marker id={`arrow-${f.path}`} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
                <path d="M 0 0 L 10 5 L 0 10 z" fill="var(--color-phi-muted)" />
              </marker>
            </defs>
            <g fill="none" stroke="var(--color-phi-muted)" stroke-width="1.25">
              <line x1={CX} y1="0" x2={CX} y2={LEAD - 2} marker-end={`url(#arrow-${f.path})`} />
              {f.steps.slice(1).map((_, i) => (
                <line x1={CX} y1={top(i) + BOX_H} x2={CX} y2={top(i + 1) - 2} marker-end={`url(#arrow-${f.path})`} />
              ))}
              <line
                x1={CX}
                y1={top(f.steps.length - 1) + BOX_H}
                x2={CX}
                y2={top(f.steps.length - 1) + BOX_H + LEAD - 2}
                marker-end={`url(#arrow-${f.path})`}
              />
              {f.loops.map((l) => (
                <path d={loopPath(l)} marker-end={`url(#arrow-${f.path})`} />
              ))}
            </g>
            {f.steps.map((step, i) => (
              <g data-node>
                <rect x={X} y={top(i)} width={BOX_W} height={BOX_H} rx="10" fill="var(--color-phi-panel)" stroke={f.stroke} stroke-width="1.25" stroke-dasharray="4 4" />
                <text x={CX} y={top(i) + BOX_H / 2} dy="0.35em" text-anchor="middle" fill="var(--color-phi-text)" font-family="var(--font-mono, ui-monospace, monospace)" font-size="13">{step}</text>
              </g>
            ))}
            {f.loops.map((l) => (
              <text
                x={X + BOX_W + 22}
                y={(top(l.to) + BOX_H + top(l.from)) / 2}
                dy="0.35em"
                text-anchor="end"
                fill="var(--color-phi-muted)"
                font-family="var(--font-mono, ui-monospace, monospace)"
                font-size="11"
              >{l.label}</text>
            ))}
            <text
              x={CX}
              y={top(f.steps.length - 1) + BOX_H + LEAD + 14}
              text-anchor="middle"
              fill="var(--color-phi-head)"
              font-family="var(--font-mono, ui-monospace, monospace)"
              font-size="12"
            >{f.out}</text>
          </svg>
          <p class="text-sm leading-relaxed text-phi-muted mt-4 max-w-[18rem]">{f.caption}</p>
        </div>
      ))}
    </div>

    <!-- Built with -->
    <div class="flex flex-wrap items-center gap-2">
      <span class="label text-phi-muted mr-2">Built with</span>
      {stack.map((item) => (
        <span class="label px-3 py-1.5 rounded-full border border-phi-rule text-phi-muted">{item}</span>
      ))}
    </div>
  </div>
</section>
