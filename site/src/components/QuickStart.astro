---
const steps = [
  { label: "01 · Install", note: "From PyPI, with uv (or pipx install phil-agent):", command: "uv tool install phil-agent" },
  { label: "02 · Set up", note: "Pick a provider and a model for each tier. Your key goes in the OS key store.", command: "phil setup" },
  { label: "03 · Run", note: "Start a chat in any git repo:", command: "phil" },
];
---

<section id="install" class="border-t border-phi-rule py-20 md:py-24">
  <div class="max-w-6xl mx-auto px-6">
    <div class="max-w-2xl mb-12">
      <p class="label text-phi-muted flex items-center gap-2.5 mb-5">
        <span class="w-[7px] h-[7px] rounded-full bg-phi-red"></span>
        <span>Install · Three commands</span>
      </p>
      <h2 class="font-serif font-light text-4xl sm:text-5xl lg:text-[52px] leading-[1.05] tracking-[-0.025em] text-phi-head mb-4">
        Install it and point it at a repo.
      </h2>
      <p class="text-lg leading-relaxed text-phi-text">
        Phil needs Python 3.14, which <code class="font-mono text-[15px] text-phi-head">uv</code> installs for you if it's missing. Run <code class="font-mono text-[15px] text-phi-head">phil setup</code> once to pick a provider and models, then run <code class="font-mono text-[15px] text-phi-head">phil</code> in any git repo.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 border border-phi-rule rounded-xl overflow-hidden">
      {steps.map((step, i) => (
        <div class={`p-7 border-phi-rule ${i < steps.length - 1 ? "border-b md:border-b-0 md:border-r" : ""}`}>
          <p class="label text-phi-yellow">{step.label}</p>
          <p class="text-sm leading-relaxed text-phi-muted mt-3 mb-4">{step.note}</p>
          <code class="block p-3 rounded-lg bg-phi-panel border border-phi-rule font-mono text-[13px] text-phi-head select-all">{step.command}</code>
        </div>
      ))}
    </div>
  </div>
</section>
