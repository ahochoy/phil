---
import { SITE_CONFIG } from "../config";
---

<section id="install" class="py-20 md:py-28 max-w-5xl mx-auto px-6">
  <!-- Section Tag -->
  <div class="flex items-center gap-2 mb-4 font-mono text-xs uppercase tracking-wider text-[#7A7268]">
    <span class="w-2 h-2 rounded-full bg-[#C26910]"></span>
    <span>Getting Started</span>
    <span class="text-[#D5CCC0]">•</span>
    <span>Zero Configuration Burden</span>
  </div>

  <div class="max-w-2xl mb-12">
    <h2 class="font-serif text-3xl sm:text-4xl lg:text-[44px] font-normal text-[#26221E] leading-[1.2] mb-4">
      Up and running in <span class="italic font-serif text-[#C26910]">seconds</span>.
    </h2>
    <p class="text-base sm:text-lg text-[#6B635B] leading-relaxed">
      No complex JSON files or hardcoded prompt templates. Run <code class="font-mono text-sm bg-[#EFE9E2] px-1.5 py-0.5 rounded text-[#26221E]">phil</code> in any git repository and let the interactive setup guide your provider, keychain, and model pairing.
    </p>
  </div>

  <!-- 3-Step Setup Card -->
  <div class="rounded-3xl bg-[#1C1917] border border-[#332E2A] p-8 text-[#EFEBE6] font-mono shadow-xl mb-14">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <!-- Step 1 -->
      <div class="space-y-3">
        <div class="flex items-center gap-2 text-[#C26910] text-xs font-bold uppercase tracking-wider">
          <span>01 · INSTALL CLI</span>
        </div>
        <p class="text-xs text-[#A3998C] font-sans">
          Install globally or as an editable tool using <code class="text-[#FAF8F5] font-mono">uv</code>:
        </p>
        <div class="p-3 rounded-xl bg-[#26221E] border border-[#3D3732] text-xs text-[#98C379] select-all">
          uv tool install --editable .
        </div>
      </div>

      <!-- Step 2 -->
      <div class="space-y-3">
        <div class="flex items-center gap-2 text-[#C26910] text-xs font-bold uppercase tracking-wider">
          <span>02 · INTERACTIVE SETUP</span>
        </div>
        <p class="text-xs text-[#A3998C] font-sans">
          Configures High/Low tiers and stores keys safely in your OS keychain:
        </p>
        <div class="p-3 rounded-xl bg-[#26221E] border border-[#3D3732] text-xs text-[#98C379] select-all">
          phil setup
        </div>
      </div>

      <!-- Step 3 -->
      <div class="space-y-3">
        <div class="flex items-center gap-2 text-[#C26910] text-xs font-bold uppercase tracking-wider">
          <span>03 · CHAT & PLAN</span>
        </div>
        <p class="text-xs text-[#A3998C] font-sans">
          Launch from any git repo to start planning and executing goals:
        </p>
        <div class="p-3 rounded-xl bg-[#26221E] border border-[#3D3732] text-xs text-[#98C379] select-all">
          phil
        </div>
      </div>
    </div>
  </div>

  <!-- Creator / Recruiter Spotlight Card -->
  <div class="p-8 sm:p-10 rounded-3xl bg-[#F4EFEA] border border-[#D5CCC0] flex flex-col md:flex-row items-center justify-between gap-8">
    <div class="max-w-xl">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#FAF8F5] border border-[#E5DDD3] text-[11px] font-mono text-[#7A7268] mb-3">
        <span>CREATOR PROFILE</span>
      </div>
      <h3 class="font-serif text-2xl font-medium text-[#26221E] mb-2">
        About Andrew Hochoy
      </h3>
      <p class="text-sm text-[#6B635B] leading-relaxed mb-4">
        I build robust AI systems, deterministic agent harnesses, and developer tooling. Phil was created as an exploration into token economics, defensive sandboxing, and contract-driven multi-agent systems.
      </p>
      <div class="flex flex-wrap items-center gap-4 text-xs font-mono">
        <a
          href={SITE_CONFIG.author.url}
          target="_blank"
          rel="noopener noreferrer"
          class="text-[#26221E] font-medium underline underline-offset-4 hover:text-[#C26910]"
        >
          andrewhochoy.com ↗
        </a>
        <a
          href={SITE_CONFIG.author.github}
          target="_blank"
          rel="noopener noreferrer"
          class="text-[#26221E] font-medium underline underline-offset-4 hover:text-[#C26910]"
        >
          GitHub (@ahochoy) ↗
        </a>
        {SITE_CONFIG.author.linkedin && (
          <a
            href={SITE_CONFIG.author.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="text-[#26221E] font-medium underline underline-offset-4 hover:text-[#C26910]"
          >
            LinkedIn ↗
          </a>
        )}
      </div>
    </div>

    <div class="flex flex-col sm:flex-row md:flex-col gap-3 w-full md:w-auto">
      <a
        href={SITE_CONFIG.links.github}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-full bg-[#26221E] text-[#FAF8F5] text-sm font-medium hover:bg-[#3D3732] transition-all text-center whitespace-nowrap shadow-sm"
      >
        <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
        </svg>
        <span>View Full Repo on GitHub</span>
      </a>
      <a
        href={SITE_CONFIG.links.cal}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-1.5 px-6 py-3 rounded-full border border-[#D5CCC0] bg-[#FAF8F5] text-[#26221E] text-xs font-mono font-medium hover:bg-[#EFE9E2] hover:border-[#B8ADA0] transition-all text-center"
      >
        <span>Schedule Intro Call (Cal.com)</span>
        <span>↗</span>
      </a>
    </div>
  </div>
</section>
