---
import { SITE_CONFIG } from "../config";

interface ArticleItem {
  num: string;
  title: string;
  date?: string;
  summary: string;
  url?: string;
  status: "live" | "coming_soon";
}

const ARTICLES: ArticleItem[] = [
  {
    num: "01",
    title: "Stop the Waste",
    date: "Oct 8, 2026",
    summary:
      "A 50-minute runaway loop on a 1-line meta tag exposes shell approval halts and harness amnesia. The birth of the live benchmark harness.",
    url: SITE_CONFIG.links.devlogPart1,
    status: "live",
  },
  {
    num: "02",
    title: "Configure Once, Any Model",
    summary:
      "Collapsing 6 complex internal agent roles into High and Low tiers. Moving secrets to the OS keychain with zero environment leak.",
    status: "coming_soon",
  },
  {
    num: "03",
    title: "The Right Amount of Process",
    summary:
      "Introducing TypeSafe Jev as a System-One decision primitive. Designing routing as a policy engine rather than a text generator.",
    status: "coming_soon",
  },
  {
    num: "04",
    title: "Paying for What You Use",
    summary:
      "Anatomy of a $3.17 planning runaway. Implementing model call caps, prompt caching, and interactive multi-choice intake questions.",
    status: "coming_soon",
  },
  {
    num: "05",
    title: "A Rule Written First",
    summary:
      "Validating classifier thresholds on 50 live benchmark runs. Why writing empirical decision rules before running tests prevents confirmation bias.",
    status: "coming_soon",
  },
];
---

<section id="benchmarks" class="py-20 md:py-28 border-t border-[#E5DDD3] bg-[#F4EFEA]/40">
  <div class="max-w-5xl mx-auto px-6">
    <!-- Section Label -->
    <div class="flex items-center gap-2 mb-4 font-mono text-xs uppercase tracking-wider text-[#7A7268]">
      <span class="w-2 h-2 rounded-full bg-[#1E40AF]"></span>
      <span>Empirical Engineering</span>
      <span class="text-[#D5CCC0]">•</span>
      <span>The 5-Part Journey</span>
    </div>

    <!-- Section Heading -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12">
      <div class="max-w-2xl">
        <h2 class="font-serif text-3xl sm:text-4xl lg:text-[44px] font-normal text-[#26221E] leading-[1.2] mb-4">
          A rule written <span class="italic font-serif text-[#1E40AF]">first</span>.
        </h2>
        <p class="text-base sm:text-lg text-[#6B635B] leading-relaxed">
          Instead of relying on anecdotal evaluation, every architectural change in Phil was measured against a live benchmark harness with hypotheses documented prior to execution.
        </p>
      </div>

      <a
        href={SITE_CONFIG.links.devlog}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-4 py-2.5 rounded-full border border-[#D5CCC0] bg-[#FAF8F5] text-xs font-mono font-medium text-[#26221E] hover:border-[#B8ADA0] hover:bg-[#EFE9E2] transition-all self-start md:self-auto"
      >
        <span>View Andrew's Dev Log</span>
        <span>↗</span>
      </a>
    </div>

    <!-- Articles List / Timeline with Two States: Live vs Coming Soon -->
    <div class="space-y-4">
      {ARTICLES.map((article) => {
        const isLive = article.status === "live";

        return isLive ? (
          /* LIVE ARTICLE CARD */
          <a
            href={article.url}
            target="_blank"
            rel="noopener noreferrer"
            class="block p-6 sm:p-7 rounded-2xl bg-[#FAF8F5] border-2 border-[#A7F3D0] hover:border-[#0B7A5A] shadow-xs hover:shadow-md transition-all group relative overflow-hidden"
          >
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-2.5">
              <div class="flex items-center gap-3 flex-wrap">
                <span class="font-mono text-xs text-[#0B7A5A] font-bold">
                  PART {article.num}
                </span>
                <span class="text-[#D5CCC0] hidden sm:inline">•</span>
                <h3 class="font-serif text-xl sm:text-2xl font-medium text-[#26221E] group-hover:text-[#0B7A5A] transition-colors">
                  {article.title}
                </h3>
              </div>

              <!-- Live Badge -->
              <div class="flex items-center gap-2 self-start sm:self-auto">
                {article.date && (
                  <span class="text-xs font-mono text-[#7A7268] hidden md:inline">
                    {article.date} ·
                  </span>
                )}
                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[#E6F4EA] border border-[#A7F3D0] text-[#0B7A5A] font-mono text-[11px] font-semibold group-hover:bg-[#0B7A5A] group-hover:text-[#FAF8F5] transition-colors">
                  <span class="w-1.5 h-1.5 rounded-full bg-[#0B7A5A] group-hover:bg-[#FAF8F5] animate-pulse"></span>
                  <span>Read Article</span>
                  <span class="text-xs">↗</span>
                </span>
              </div>
            </div>

            <p class="text-xs sm:text-sm text-[#4A443D] leading-relaxed max-w-3xl">
              {article.summary}
            </p>
          </a>
        ) : (
          /* COMING SOON CARD */
          <div class="p-6 rounded-2xl bg-[#F7F3EE]/70 border border-[#E5DDD3] opacity-80">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-2.5">
              <div class="flex items-center gap-3 flex-wrap">
                <span class="font-mono text-xs text-[#8C827A] font-medium">
                  PART {article.num}
                </span>
                <span class="text-[#D5CCC0] hidden sm:inline">•</span>
                <h3 class="font-serif text-xl font-normal text-[#6B635B]">
                  {article.title}
                </h3>
              </div>

              <!-- Coming Soon Badge -->
              <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-[#EFE9E2] border border-[#E0D7CC] text-[#8C827A] font-mono text-[11px] font-medium self-start sm:self-auto">
                <span>Coming Soon</span>
              </span>
            </div>

            <p class="text-xs sm:text-sm text-[#7A7268] leading-relaxed max-w-3xl font-light">
              {article.summary}
            </p>
          </div>
        );
      })}
    </div>
  </div>
</section>
