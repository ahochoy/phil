---
import "../styles/global.css";
import { SITE_CONFIG } from "../config";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${SITE_CONFIG.title} — ${SITE_CONFIG.tagline}`,
  description = SITE_CONFIG.description,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph / Social -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/assets/banner.jpg" />
    <meta property="og:url" content="https://github.com/ahochoy/phil" />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Google Fonts: Newsreader (editorial serif), Plus Jakarta Sans (geometric sans), JetBrains Mono (monospaced) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400;1,6..72,500&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-[#FAF8F5] text-[#4A443D] selection:bg-[#E2D9CC] selection:text-[#26221E] antialiased">
    <!-- Subtle architectural museum background grid/texture -->
    <div
      class="fixed inset-0 pointer-events-none opacity-[0.03] z-[-1]"
      style="background-image: radial-gradient(#26221E 1px, transparent 1px); background-size: 32px 32px;"
    >
    </div>

    <!-- Header Navigation in Taupe palette matching the Hero -->
    <header class="sticky top-0 z-50 backdrop-blur-md bg-[#352F2A]/90 border-b border-[#4D453E] transition-all">
      <div class="max-w-6xl mx-auto px-6 h-18 flex items-center justify-between">
        <!-- Brand -->
        <a href="#" class="flex items-center gap-3 group">
          <div class="w-8 h-8 rounded-full border border-[#554C43] bg-[#433B34] flex items-center justify-center font-serif text-[#FAF8F5] text-lg font-medium shadow-xs group-hover:border-[#F59E0B] transition-colors">
            φ
          </div>
          <div class="flex flex-col">
            <span class="font-serif text-xl tracking-tight font-medium text-[#FAF8F5] leading-none group-hover:text-[#F59E0B] transition-colors">
              Phil
            </span>
            <span class="text-[11px] tracking-wider uppercase text-[#B8ADA0] font-mono mt-0.5">
              φιλία · dev agent
            </span>
          </div>
        </a>

        <!-- Desktop Navigation -->
        <nav class="hidden md:flex items-center gap-7 text-[13px] font-medium tracking-wide text-[#D5CCC0]">
          <a href="#origin" class="hover:text-[#FAF8F5] transition-colors">Origin</a>
          <a href="#architecture" class="hover:text-[#FAF8F5] transition-colors">Architecture</a>
          <a href="#pillars" class="hover:text-[#FAF8F5] transition-colors">Engineering Pillars</a>
          <a href="#benchmarks" class="hover:text-[#FAF8F5] transition-colors">Benchmarks</a>
          <a href="#install" class="hover:text-[#FAF8F5] transition-colors">Quickstart</a>
        </nav>

        <!-- Action Buttons -->
        <div class="flex items-center gap-3">
          <a
            href={SITE_CONFIG.links.personalSite}
            target="_blank"
            rel="noopener noreferrer"
            class="hidden sm:inline-flex items-center gap-1.5 text-[12px] font-mono font-medium px-3 py-1.5 rounded-full border border-[#554C43] bg-[#433B34] text-[#D5CCC0] hover:text-[#FAF8F5] hover:border-[#6B6055] transition-all"
          >
            <span>by Andrew Hochoy</span>
            <span class="text-[#A3998C]">↗</span>
          </a>
          <a
            href={SITE_CONFIG.links.github}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 text-[13px] font-medium px-4 py-2 rounded-full bg-[#FAF8F5] text-[#26221E] hover:bg-[#EFE9E2] shadow-sm transition-all"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
            </svg>
            <span>GitHub</span>
          </a>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <!-- Footer -->
    <footer class="border-t border-[#E5DDD3] bg-[#F4EFEA] py-14 mt-24">
      <div class="max-w-6xl mx-auto px-6 flex flex-col md:flex-row items-center justify-between gap-6">
        <div class="flex items-center gap-3">
          <div class="w-7 h-7 rounded-full border border-[#D5CCC0] bg-[#FAF8F5] flex items-center justify-center font-serif text-[#26221E] text-sm">
            φ
          </div>
          <p class="text-sm text-[#7A7268]">
            Phil is an open-source development agent built by <a href={SITE_CONFIG.links.personalSite} class="text-[#26221E] font-medium underline underline-offset-3 hover:text-[#C26910]">Andrew Hochoy</a>.
          </p>
        </div>
        <div class="flex items-center gap-6 text-xs font-mono text-[#7A7268]">
          <a href={SITE_CONFIG.links.devlogPart1} target="_blank" class="hover:text-[#26221E] transition-colors">Dev Log (Part 1) ↗</a>
          <a href={SITE_CONFIG.links.github} target="_blank" class="hover:text-[#26221E] transition-colors">GitHub Repository ↗</a>
          <a href={SITE_CONFIG.links.cal} target="_blank" class="hover:text-[#26221E] transition-colors">Intro Call ↗</a>
        </div>
      </div>
    </footer>
  </body>
</html>
